diff --git a/proton b/proton
index 073368e1..aca7029c 100755
--- a/proton
+++ b/proton
@@ -1622,6 +1622,20 @@ class Session:
             os.environ["PROTON_DISABLE_LSTEAMCLIENT"] = "1"
             self.env["PROTON_DISABLE_LSTEAMCLIENT"] = "1"
 
+        # Default these on. Only applied when the variable is absent, so an
+        # explicit value in the launch options always wins - setting any of
+        # them to 0 disables the feature as usual.
+        # PROTON_FSR4_UPGRADE selects the amdxcffx64 build protonfixes installs;
+        # FSR4_UPGRADE is read by wine's own AMD shims (dlls/amdxc64/main.c,
+        # dlls/win32u/d3dkmt.c). check_environment() reads self.env, so set both.
+        for name, value in (("PROTON_ENABLE_WAYLAND", "1"),
+                            ("PROTON_FSR4_UPGRADE", "1"),
+                            ("FSR4_UPGRADE", "1"),
+                            ("MANGOHUD", "1")):
+            if name not in os.environ:
+                os.environ[name] = value
+                self.env[name] = value
+
         # CW Bug 21737. Locoland executable happens to be steam.exe.
         if os.environ.get("SteamGameId", 0) == "352130":
             del self.dlloverrides["steam.exe"]
